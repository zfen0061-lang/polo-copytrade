{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start CopyTrade Studio / 启动应用",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "backend.server"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "cmd",
        "args": [
          "/d",
          "/c",
          "start.cmd"
        ]
      }
    },
    {
      "label": "Run tests / 运行测试",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Check local setup / 检查运行环境",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "backend.doctor"
      ],
      "windows": {
        "command": "cmd",
        "args": [
          "/d",
          "/c",
          "check.cmd"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
